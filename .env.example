# Copy this file to `.env` for local runs. On a cloud host, set these same
# names as environment variables in the host's dashboard instead.

# --- Required: Discord app (https://discord.com/developers/applications) ---
TOKEN=
CLIENT_ID=
CLIENT_SECRET=
# Your own Discord user ID (enable Developer Mode -> right-click yourself -> Copy User ID)
ADMIN_ID=

# --- Required: Lavalink v4 / NodeLink server (does the actual audio streaming) ---
LAVALINK_HOST=
LAVALINK_PORT=443
LAVALINK_PASSWORD=
# true if the node uses SSL/wss (usually when the port is 443)
LAVALINK_SECURE=true
# Only for your OWN Lavalink server with the YouTube plugin's login (OAuth) enabled:
# the refresh token, which the bot sends to the server each time it connects.
YOUTUBE_REFRESH_TOKEN=

# --- Optional: backup Lavalink server, used automatically if the main one goes down ---
LAVALINK2_HOST=
LAVALINK2_PORT=443
LAVALINK2_PASSWORD=
LAVALINK2_SECURE=true

# --- Optional ---
# Public URL of the bot's web server. Auto-detected on Render.
# WEBSITE=https://your-app.example.com
# Random string used to sign dashboard login cookies
# COOKIE_SECRET=
# PORT=4200
# TWENTY_FOUR_SEVEN=false
# AUTO_QUEUE=false
# AUTO_PAUSE=true
# AUTO_LEAVE=false
# DEFAULT_VOLUME=100
# DISCONNECT_TIME=30000
# DEBUG=false

# --- Optional: what the bot shows in Discord's member list ---
# ACTIVITY_TYPE: PLAYING, LISTENING, WATCHING or COMPETING  (e.g. "Listening to Music")
# ACTIVITY_TEXT=Music
# ACTIVITY_TYPE=LISTENING
# BOT_STATUS: online, idle, dnd (do not disturb) or invisible
# BOT_STATUS=online
